{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "everything": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-everything"],
      "environment": { "MY_ENV_VAR": "value" },
      "enabled": true
    },
    "jira": {
      "type": "remote",
      "url": "https://jira.example.com/mcp",
      "headers": { "Authorization": "Bearer test-not-a-real-token" },
      "enabled": false
    }
  }
}
