{
  "mcpServers": {
    "filesystem": {
      "transport": "stdio",
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-filesystem", "/tmp"],
      "env": {
        "FS_API_KEY": "test-not-a-real-token"
      },
      "alwaysAllow": ["list_directory", "read_file"]
    },
    "api-server": {
      "transport": "http",
      "url": "https://mcp.example.com/mcp",
      "headers": {
        "Authorization": "Bearer test-not-a-real-token"
      },
      "timeout": 30000
    }
  }
}
