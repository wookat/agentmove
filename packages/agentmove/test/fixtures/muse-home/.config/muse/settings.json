{
  "schema_version": 1,
  "theme": "dark",
  "mcp_servers": {
    "filesystem": {
      "transport": "stdio",
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-filesystem", "/tmp"],
      "env": { "FS_API_KEY": "test-not-a-real-token" }
    },
    "api-server": {
      "transport": "streamable_http",
      "url": "https://mcp.example.com/mcp",
      "headers": { "Authorization": "Bearer test-not-a-real-token" },
      "mode": "optional"
    }
  }
}
