{
  "mcpServers": {
    "local-tools": {
      "command": "node",
      "args": ["server.js"],
      "env": { "API_KEY": "test-not-a-real-token" },
      "alwaysAllow": ["tool1"],
      "disabled": false
    },
    "modern-remote": {
      "type": "streamable-http",
      "url": "https://mcp.example.com/mcp",
      "headers": { "Authorization": "Bearer test-not-a-real-token" },
      "disabled": true
    },
    "legacy-remote": {
      "type": "sse",
      "url": "https://legacy.example.com/mcp-base"
    }
  }
}
