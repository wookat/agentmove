{
  "mcpServers": {
    "filesystem": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-filesystem", "/tmp"],
      "env": {
        "FS_API_KEY": "test-not-a-real-token"
      },
      "anythingllm": {
        "suppressedTools": ["delete_file"]
      }
    },
    "api-server": {
      "type": "streamable",
      "url": "https://mcp.example.com/mcp",
      "headers": {
        "Authorization": "Bearer test-not-a-real-token"
      }
    }
  }
}
