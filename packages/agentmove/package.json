{
  "name": "agentmove-cli",
  "version": "0.79.0",
  "description": "Move your AI agent between clients — config, MCP servers, skills, memory, persona. Any direction, dry-run first, lossless where possible.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wookat/agentmove.git",
    "directory": "packages/agentmove"
  },
  "keywords": [
    "agent",
    "migration",
    "mcp",
    "claude-code",
    "codex",
    "cursor",
    "gemini-cli",
    "openclaw",
    "hermes"
  ],
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "agentmove": "./dist/cli.js"
  },
  "files": [
    "dist",
    "man"
  ],
  "man": [
    "./man/agentmove-cli.1"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "json5": "^2.2.3",
    "smol-toml": "^1.4.2",
    "yaml": "^2.8.2"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@vitest/coverage-v8": "4.1.10",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
